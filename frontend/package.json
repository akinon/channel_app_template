{
  "name": "channel-app-fe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node server/index.js",
    "dev:shell": "akinon-ui shell --config=shell.config.js",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@akinon/ui-cli": "^2.0.1",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/redux-logger": "^3.0.13",
    "@types/tcp-port-used": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "@vitest/coverage-v8": "^3.0.6",
    "@vitest/ui": "^3.0.6",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^15.11.7",
    "msw": "^2.10.5",
    "prettier": "^3.2.5",
    "sass": "^1.68.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "@akinon/akidate": "^1.0.0",
    "@akinon/akifilter": "^0.5.4",
    "@akinon/akiform": "^1.0.1",
    "@akinon/akilocale": "^1.0.0",
    "@akinon/akitable": "^1.1.0",
    "@akinon/akival": "^1.0.1",
    "@akinon/app-client": "^1.0.0",
    "@akinon/fonts-jost-variable": "^1.0.0",
    "@akinon/icons": "^1.0.1",
    "@akinon/ui-layout": "^1.3.0",
    "@akinon/ui-react": "^1.2.0",
    "@akinon/ui-spin": "^1.1.0",
    "@akinon/ui-system": "^1.0.0",
    "@akinon/ui-utils": "^1.0.1",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.11.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "tcp-port-used": "^1.0.2"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
